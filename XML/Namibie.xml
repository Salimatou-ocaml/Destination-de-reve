        <historical_facts>
            <figure_historique>
                <nom_historique>Hendrik Witbooi</nom_historique>
                <periode fin="" debut="" >De(1830 à 1905 )Chef des nama</periode>
                <contribution>
                    Figure de la résistance contre la colonisation Allemande.
                    Il a mené des campagnes contre les forces coloniales avant d'être tué au combat.
                    Il figure de nos jours sur les billets de banque namibiens.
                </contribution>
            </figure_historique>
            <figure_historique>
                <nom_historique>Samuel Maharero </nom_historique>
                <periode fin="" debut="">De (1856 à 1923) chef des herero </periode>
                <contribution>
                    Il a dirigé la révolte Herero contre les Allemands en 1904 ,
                    un événement tragique qui a mené au génocide des Herero et Nama (1904–1908).
                    il mena une grosse lutte pour la survie et la dignité de son peuple
                </contribution>
            </figure_historique>
            <figure_historique>
                <nom_historique>Hosea kutako</nom_historique>
                <periode fin=" " debut="" > De (1870 à 1970° Leader religieux et politique Herero</periode>
                <contribution>Il a joué un rôle essentiel dans la lutte pour les droits civiques des
                    Namibiens sous le mandat sud-africain. Il est l'un des premiers à demander
                    l'indépendance de la Namibie aux Nations Unies.
                </contribution>
            </figure_historique>
        </historical_facts>
